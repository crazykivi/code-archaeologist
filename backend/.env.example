# App
APP_ENV=development
PORT=8080
# GIN_MODE=debug
ALLOW_CORS=http://localhost:5173
TRUSTED_PROXIES=

# Database
DB_PATH=data.db

# LLM defaults
DEFAULT_LLM_PROVIDER=openai

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMACPP_API_KEY=
LLAMACPP_MODEL=local

OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=not-needed
OPENAI_MODEL=local

DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus

# Любой OpenAI-совместимый провайдер можно подключить через CUSTOM_*
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

# Git
GIT_ALLOWED_HOSTS=github.com,gitlab.com
LOCAL_ROOTS=
CLONE_ROOT=
GIT_TIMEOUT_SECONDS=600
MAX_COMMITS=1000

# Analysis
ANALYSIS_BATCH_SIZE=20
MAX_CONCURRENT_JOBS=1
LLM_REQUEST_TIMEOUT_SECONDS=1800
JOB_TIMEOUT_SECONDS=7200
LLM_TEMPERATURE=0.1

# Cascade (Map-Reduce)
CASCADE_ENABLED=true
CASCADE_MAX_PARALLEL=1
CASCADE_REDUCE_SIZE=50

# Diff
DIFF_ENABLED=true
DIFF_MAX_SIZE_PER_COMMIT=3000

# Rate limits (requests/min; 0 disables)
RATE_LIMIT_ANALYZE_PER_MINUTE=5
RATE_LIMIT_READ_PER_MINUTE=120